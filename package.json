{
  "name": "student-ide",
  "version": "1.0.0",
  "description": "Student IDE V1 - Lightweight, offline desktop IDE for school students (Classes 6-12)",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:5173 && electron .\"",
    "start": "npm run build:electron && electron .",
    "test": "node tests/test_cpp_execution.js && node tests/test_cpp_stop_execution.js && node tests/test_admin_survey_module.js && node tests/test_survey_module.js && node tests/audit_phase3.js && node tests/test_two_computer_lab_simulation.js && node tests/run_functional_test.js",
    "setup:runtimes": "node scripts/setup_runtimes.js",
    "package": "npm run setup:runtimes && npm run build && electron-builder --win --dir",
    "dist:win": "npm run setup:runtimes && npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "keywords": [
    "student",
    "ide",
    "offline",
    "education",
    "monaco",
    "electron"
  ],
  "author": "Developer Hut (https://github.com/DeveloperHutOrg)",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "in.developerhut.studentide",
    "productName": "Student IDE",
    "copyright": "Copyright © 2026 DeveloperHut",
    "directories": {
      "output": "dist-package",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtimes",
        "to": "runtimes",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Student IDE",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
